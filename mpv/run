#!/usr/bin/env bash

set -o pipefail

__run_program=mpv
__dbus_stop=true

. "${X11APPJAIL_WORKDIR}/appjail.d/lib.subr"
. "${X11APPJAIL_WORKDIR}/appjail.d/dbus.subr"

FILE=
IS_LOCAL=true

if [ $# -gt 0 ]; then
    FILE="${@: -1}"

    if [ "${FILE}" != "--" ]; then
        case "${FILE}" in
            file://*) FILE="${FILE#file://}" ;;
            jail://*) FILE="${FILE#jail://}"; IS_LOCAL=false ;;
            *://*) IS_LOCAL=false ;;
        esac

        if ${IS_LOCAL}; then
            if run_as [ ! -e "${FILE}" ]; then
                err "${FILE}: file not found or no read permission."
                exit 1
            fi

            if run_as [ ! -f "${FILE}" ]; then
                err "${FILE}: not a regular file."
                exit 1
            fi
        fi

        if ${IS_LOCAL}; then
            set -- "${@:1:$#-1}" "-"
        elif [ -n "${FILE}" ]; then
            set -- "${@:1:$#-1}" "${FILE}"
        else
            set -- "${@:1:$#-1}"
        fi
    else
        unset FILE
    fi
fi

. "${X11APPJAIL_WORKDIR}/appjail.d/perms.subr"

if ${__perms_allow_3d}; then
    set -- --vo=gpu --gpu-api=opengl --hwdec=auto --hwdec-codecs=all "$@"
fi

if [ -n "${FILE}" ] && ${IS_LOCAL}; then
    __run_stdin="${FILE}"
fi

. "${X11APPJAIL_WORKDIR}/appjail.d/run.subr"
